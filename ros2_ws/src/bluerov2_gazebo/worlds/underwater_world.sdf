<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="underwater_world">
    <physics name="2ms" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 0</gravity>

    <scene>
      <ambient>0.35 0.45 0.55 1</ambient>
      <background>0.02 0.08 0.22 1</background>
      <fog><color>0.03 0.10 0.22 1</color><type>linear</type><density>0.01</density><start>15</start><end>120</end></fog>
    </scene>

    <light type="directional" name="ocean_sun">
      <cast_shadows>true</cast_shadows><pose>0 0 50 0 0 0</pose>
      <diffuse>0.55 0.65 0.75 1</diffuse><specular>0.2 0.25 0.3 1</specular>
      <attenuation><range>500</range><constant>0.9</constant><linear>0.002</linear><quadratic>0.0005</quadratic></attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows><pose>10 -5 40 0 0 0</pose>
      <diffuse>0.35 0.45 0.50 1</diffuse><specular>0.1 0.12 0.15 1</specular>
      <direction>0.1 -0.1 -1.0</direction>
    </light>
    <light type="point" name="glow">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.5 0.6 1</diffuse><specular>0.1 0.12 0.15 1</specular>
      <attenuation><range>60</range><constant>0.6</constant><linear>0.02</linear><quadratic>0.005</quadratic></attenuation>
    </light>

    <!-- SEABED — bright sandy -->
    <model name="seabed"><static>true</static><pose>0 0 -2 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>200 200 0.05</size></box></geometry>
        <material><ambient>0.55 0.48 0.32 1</ambient><diffuse>0.72 0.62 0.42 1</diffuse><specular>0.1 0.08 0.05 1</specular></material>
      </visual></link></model>

    <!-- Mud patches — darker brown -->
    <model name="mud1"><static>true</static><pose>3 -2 -1.97 0 0 0.3</pose>
      <link name="l"><visual name="v"><geometry><box><size>6 4 0.02</size></box></geometry>
        <material><ambient>0.25 0.20 0.12 1</ambient><diffuse>0.38 0.30 0.18 1</diffuse></material>
      </visual></link></model>
    <model name="mud2"><static>true</static><pose>-5 4 -1.97 0 0 -0.5</pose>
