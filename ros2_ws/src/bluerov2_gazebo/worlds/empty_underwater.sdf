<?xml version="1.0" ?>
<!--
  Empty Underwater World — Gazebo Harmonic
  =========================================
  Minimal deep-ocean environment for quick controller testing.
  No obstacles — just physics, lighting, and a seabed.
-->
<sdf version="1.9">
  <world name="empty_underwater">

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 0</gravity>

    <scene>
      <ambient>0.1 0.15 0.3 1.0</ambient>
      <background>0.0 0.05 0.15 1.0</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.3 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Seabed -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -100 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>200 200 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.15 1</ambient>
            <diffuse>0.5 0.4 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>200 200 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ── World Plugins ──────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <uniform_buoyancy>true</uniform_buoyancy>
      <use_curr_pose>true</use_curr_pose>
      <graded_buoyancy>
        <default_density>1028</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.225</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

  </world>
</sdf>
