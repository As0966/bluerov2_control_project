<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_gazebo</name>
  <version>1.0.0</version>
  <description>
    Gazebo Harmonic underwater worlds and simulation launch files
    for the BlueROV2 vehicle (ROS 2 Humble).
  </description>

  <maintainer email="bayisa@todo.todo">bayisa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bluerov2_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
