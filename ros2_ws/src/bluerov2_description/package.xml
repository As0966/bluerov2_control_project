<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_description</name>
  <version>1.0.0</version>
  <description>
    BlueROV2 robot model for Gazebo Harmonic (ROS 2 Humble).
    Standalone SDF model with 6 thrusters, IMU, cameras, DVL,
    and hydrodynamic parameters from Berg 2012.
  </description>

  <maintainer email="bayisa@todo.todo">bayisa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
